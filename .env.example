# Luke Shop Backend v0.11.1
NODE_ENV=development
HOST=0.0.0.0
PORT=4100
LOG_LEVEL=info
TRUST_PROXY=false

# PostgreSQL / Neon. Use a pooled production connection string where appropriate.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/luke_shop
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# Use a long random secret (64+ characters recommended).
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-64-characters-before-production
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# High-entropy server-side pepper used to hash service-to-service credentials.
SERVICE_CREDENTIAL_PEPPER=replace-with-a-second-long-random-secret-at-least-64-characters

# Browser origins only. Native apps and service-to-service requests do not send Origin.
CORS_ORIGINS=http://localhost:4172,http://localhost:4173,http://localhost:4174

BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Use a separate 48+ character secret in production for signed Luke CS customer contexts.
CS_CONTEXT_SIGNING_SECRET=replace-with-a-separate-long-random-context-signing-secret-at-least-48-characters
CS_SERVICE_SIGNING_SECRET=replace-with-a-different-random-secret-at-least-48-characters-long
CS_SERVICE_TOKEN_TTL_SECONDS=300
CS_REQUEST_MAX_SKEW_SECONDS=120
CS_REQUEST_NONCE_TTL_SECONDS=300

# Optional hosted tenant subdomain suffix, e.g. shops.example.com -> tenant.shops.example.com
STOREFRONT_HOST_SUFFIX=
STOREFRONT_PREVIEW_TTL_SECONDS=600

# Media Asset Library
# LOCAL is suitable for development. Production on ephemeral hosts should use R2.
ASSET_STORAGE_DRIVER=LOCAL
ASSET_LOCAL_DIR=.data/assets
ASSET_PUBLIC_BASE_URL=http://localhost:4100

# Cloudflare R2 (required when ASSET_STORAGE_DRIVER=R2)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional public R2/custom-domain base URL for PUBLIC assets. If omitted, public media is proxied by Backend.
R2_PUBLIC_BASE_URL=
ASSET_IMAGE_MAX_BYTES=10485760
ASSET_VIDEO_MAX_BYTES=104857600


# Customer identity login providers (all optional; tenant settings can enable only configured providers)
CUSTOMER_GOOGLE_CLIENT_ID=
CUSTOMER_TELEGRAM_CLIENT_ID=
CUSTOMER_TELEGRAM_CLIENT_SECRET=
CUSTOMER_TELEGRAM_BOT_USERNAME=
CUSTOMER_TELEGRAM_BOT_TOKEN=
CUSTOMER_TURNSTILE_ENABLED=false
CUSTOMER_TURNSTILE_SITE_KEY=
CUSTOMER_TURNSTILE_SECRET_KEY=
CUSTOMER_TURNSTILE_HOSTNAMES=
CUSTOMER_TURNSTILE_LOGIN_REQUIRED=true
CUSTOMER_TURNSTILE_SIGNUP_REQUIRED=true
CUSTOMER_TURNSTILE_SOCIAL_REQUIRED=false
CUSTOMER_PHONE_OTP_WEBHOOK_URL=
CUSTOMER_PHONE_OTP_WEBHOOK_BEARER=
CUSTOMER_PHONE_OTP_HASH_SECRET=

# Google Maps + Delivery Address Pro
# Production recommended: GOOGLE. Use separate restricted keys for server geocoding and browser maps.

# Google Maps + Delivery Address Pro
# NONE | NOMINATIM | GOOGLE
GEOCODING_PROVIDER=NONE
GEOCODING_BASE_URL=
GOOGLE_GEOCODING_API_KEY=
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_MAP_ID=
