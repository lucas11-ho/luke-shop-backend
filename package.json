{
  "name": "luke-shop-backend",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "Luke Shop multi-tenant commerce backend with Store Designer v3 and operations/control completion",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "start:env": "node --env-file=.env src/server.js",
    "migrate": "node --env-file=.env src/db/migrate.js",
    "bootstrap:tenant": "node --env-file=.env src/scripts/bootstrap-tenant.js",
    "check": "node scripts/check-source.mjs",
    "test:source": "node scripts/source-regression-test.mjs",
    "verify": "npm run check && npm run test:source && npm run test:auth:source && npm run test:http:core && npm run test:http:source && npm run test:catalog:source && npm run test:orders:core && npm run test:orders:source && npm run test:commerce:core && npm run test:commerce:source && npm run test:runtime:source && npm run test:commerce-defaults:core && npm run test:commerce-runtime:source && npm run test:cs-policy:core && npm run test:cs-connector:source && npm run test:staff-rbac:source && npm run test:platform:source && npm run test:routing:source && npm run test:assets:source && npm run test:experience-v2:source && npm run test:experience-v3:source && npm run test:operations-v011",
    "ci": "npm run verify",
    "test:db": "node --env-file=.env.ci scripts/db-smoke-test.mjs",
    "test:auth-db": "node --env-file=.env.ci scripts/auth-lifecycle-test.mjs",
    "test:auth:local": "node --env-file=.env scripts/auth-lifecycle-test.mjs",
    "test:http": "node scripts/http-semantics-test.mjs",
    "test:http:source": "node scripts/v0.1.2-http-error-semantics-regression-test.mjs",
    "test:auth:source": "node scripts/v0.1.1-auth-reliability-regression-test.mjs",
    "test:http:core": "node scripts/http-error-normalizer-test.mjs",
    "test:catalog:source": "node scripts/v0.2.0-catalog-inventory-regression-test.mjs",
    "test:catalog-db": "node --env-file=.env.ci scripts/catalog-inventory-lifecycle-test.mjs",
    "test:catalog:local": "node --env-file=.env scripts/catalog-inventory-lifecycle-test.mjs",
    "test:orders:core": "node scripts/order-state-machine-test.mjs",
    "test:orders:source": "node scripts/v0.3.0-cart-checkout-orders-regression-test.mjs",
    "test:orders-db": "node --env-file=.env.ci scripts/orders-lifecycle-test.mjs",
    "test:orders:local": "node --env-file=.env scripts/orders-lifecycle-test.mjs",
    "orders:expire": "node --env-file=.env src/scripts/expire-orders.js",
    "test:commerce:core": "node scripts/commerce-core-test.mjs",
    "test:commerce:source": "node scripts/v0.4.0-payments-delivery-promotions-regression-test.mjs",
    "test:commerce-db": "node --env-file=.env.ci scripts/payments-delivery-promotions-lifecycle-test.mjs",
    "test:commerce:local": "node --env-file=.env scripts/payments-delivery-promotions-lifecycle-test.mjs",
    "test:runtime:source": "node scripts/v0.4.1-runtime-integration-regression-test.mjs",
    "test:commerce-runtime:source": "node scripts/v0.4.2-commerce-runtime-reliability-regression-test.mjs",
    "test:commerce-defaults:core": "node scripts/commerce-defaults-core-test.mjs",
    "test:cs-policy:core": "node scripts/cs-policy-core-test.mjs",
    "test:cs-connector:source": "node scripts/v0.5.0-cs-commerce-connector-regression-test.mjs",
    "test:cs-connector-db": "node --env-file=.env.ci scripts/cs-commerce-connector-lifecycle-test.mjs",
    "test:cs-connector:local": "node --env-file=.env scripts/cs-commerce-connector-lifecycle-test.mjs",
    "cs:cleanup": "node --env-file=.env src/scripts/cleanup-cs-contexts.js",
    "test:staff-rbac:source": "node scripts/v0.6.0-merchant-staff-rbac-regression-test.mjs",
    "test:staff-rbac-db": "node --env-file=.env.ci scripts/merchant-staff-rbac-lifecycle-test.mjs",
    "test:staff-rbac:local": "node --env-file=.env scripts/merchant-staff-rbac-lifecycle-test.mjs",
    "bootstrap:platform-owner": "node --env-file=.env src/scripts/bootstrap-platform-owner.js",
    "test:platform:source": "node scripts/v0.7.0-platform-control-plane-regression-test.mjs",
    "test:routing:source": "node scripts/v0.7.1-storefront-routing-regression-test.mjs",
    "test:assets:source": "node scripts/v0.8.0-media-asset-library-regression-test.mjs",
    "test:experience-v2:source": "node scripts/v0.9.0-experience-commerce-workflow-regression-test.mjs",
    "test:experience-v3:source": "node scripts/v0.10.0-store-designer-v3-regression-test.mjs",
    "test:operations-v011": "node scripts/v0.11.0-operations-control-completion-regression-test.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.1.0",
    "fastify": "5.11.3",
    "jose": "6.2.3",
    "pg": "8.22.0"
  }
}
